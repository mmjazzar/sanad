{
  "manifest_version": 3,
  "name": "Sanad – Hadith & Seerah Source Checker",
  "short_name": "Sanad",
  "version": "0.1.0",
  "description": "Select any text (English or Arabic) and check whether it is grounded in approved Islamic sources: hadith, Seerah and Quran — with sources, grading and an audit.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Sanad", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.novita.ai/*", "https://api.tavily.com/*"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
